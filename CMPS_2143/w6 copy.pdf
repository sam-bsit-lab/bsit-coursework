## Q17
class Rectangle : public Shape {

private:

    double width;
    double height;
public:

    Rectangle(double w,double h) : Shape("rectangle"),width(w),height(h) {}

    double area() const override { 
        return width * height;
    }
};

## Q18
double totaArea(const vector<Shape*>& shapes) {

    double total = 0;

    for (Shape* s : shapes) {
        total += s->area();
    }

    return total;
};
   returns: 9.14159

